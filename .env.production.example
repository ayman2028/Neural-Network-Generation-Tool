# Production Environment Configuration
# Copy this to .env and update all values for your production environment
# NEVER commit this file to version control!

# ============================================================================
# DJANGO SETTINGS
# ============================================================================

# Set to False for production
DEBUG=False

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# CHANGE THIS TO A STRONG RANDOM KEY!
SECRET_KEY=django-insecure-change-this-to-random-key-generated-above

# Your domain(s)
ALLOWED_HOSTS=example.com,www.example.com,your-server-ip

# Module for Django settings
DJANGO_SETTINGS_MODULE=config.settings

# Don't write bytecode files
PYTHONDONTWRITEBYTECODE=1

# Don't buffer output
PYTHONUNBUFFERED=1

# ============================================================================
# DATABASE SETTINGS
# ============================================================================

# PostgreSQL configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=neural_network_prod
DB_USER=postgres

# Generate a strong password: openssl rand -base64 32
DB_PASSWORD=your-strong-database-password-here

# EC2 host PostgreSQL (Docker on Linux): use host.docker.internal — docker-compose.prod.yml
# maps it to the host gateway. Ensure Postgres listens on the docker bridge (not only 127.0.0.1),
# e.g. listen_addresses = '*' or the instance private IP in postgresql.conf, and allow the
# bridge subnet in pg_hba.conf. For Amazon RDS instead, set DB_HOST to your RDS endpoint and
# DB_SSLMODE=require.
DB_HOST=host.docker.internal
DB_PORT=5432

# libpq sslmode: prefer (default) uses TLS when the server offers it; disable for local Postgres
# without SSL; require for RDS and other hosts that mandate TLS.
DB_SSLMODE=prefer

# Full database URL (constructed from above; informational for tools that read DATABASE_URL)
DATABASE_URL=postgresql://postgres:your-strong-database-password-here@host.docker.internal:5432/neural_network_prod

# ============================================================================
# REDIS SETTINGS
# ============================================================================

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# CELERY SETTINGS
# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Set to False in production (tasks will run asynchronously)
CELERY_ALWAYS_EAGER=False

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Output directory for generated neural networks
OUTPUT_DIR=/app/generator/outputs

# ============================================================================
# PORT SETTINGS
# ============================================================================

WEB_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ============================================================================
# DJANGO SECURITY SETTINGS
# ============================================================================

# Enable HTTPS redirect (set to True for production with SSL)
SECURE_SSL_REDIRECT=False

# Secure cookies
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS settings (use with caution, can lock you out)
# Uncomment when SSL is fully configured
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Email configuration for alerts
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# OPTIONAL: BACKUP SETTINGS
# ============================================================================

# Backup location
BACKUP_PATH=/backups

# Backup frequency (in hours)
BACKUP_INTERVAL=24

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================

# Security Checklist:
# 1. Change SECRET_KEY to a strong random value
# 2. Generate strong DB_PASSWORD
# 3. Configure SSL certificates in nginx.conf
# 4. Set DEBUG=False
# 5. Update ALLOWED_HOSTS with your domain
# 6. Configure email backend for alerts
# 7. Set up monitoring and logging
# 8. Configure backups
# 9. Review and uncomment SECURE_* settings when SSL is ready
# 10. Test thoroughly before going live

# Commands to generate secure values:
# SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DB_PASSWORD: openssl rand -base64 32
# Random token: openssl rand -hex 32
